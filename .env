# ─── Media Stack ─────────────────────────────────────────────────────────────
# Copiá este archivo como `.env` (cp .env.example .env) y editá lo que
# necesites. Con los defaults ya funciona, no es obligatorio tocar nada.
#
#   cp .env.example .env
#   bash scripts/bootstrap.sh
#
# Antes había que editar docker-compose.yml a mano para PUID/PGID/TZ y
# después clickear un rato largo en cada app. Ahora todo sale de acá +
# scripts/bootstrap.sh hace la configuración por API.

# ─── Rutas de almacenamiento ───────────────────────────────────────────────────
# Defaults: ./config y ./data relativos a este archivo.
# Para moverlas (ej. a un disco aparte): CONFIG_DIR=/srv/media-stack/config
CONFIG_DIR=./config
DATA_DIR=./data

# ─── Usuario / permisos ────────────────────────────────────────────────────────
# Corré `id -u` / `id -g` en el server y poné esos valores acá para que los
# archivos que crean los containers te pertenezcan a vos, no a root.
PUID=1000
PGID=1000

# ─── Zona horaria ──────────────────────────────────────────────────────────────
# Lista completa: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Argentina/Mendoza

# ─── Dominio / URL pública ──────────────────────────────────────────────────────
# Si tenés un dominio con DNS apuntando al server, ponelo acá y
# scripts/bootstrap.sh configura HTTPS automático (Let's Encrypt) en el Caddyfile.
# Dejalo vacío para quedarte en HTTP plano (autofirmado/local).
DOMAIN=
# Email de contacto para Let's Encrypt (solo se usa si DOMAIN no está vacío).
ACME_EMAIL=

# URL pública de Jellyfin (se usa para JELLYFIN_PublishedServerUrl y para que
# Jellyseerr arme links correctos). Si tenés dominio, algo tipo https://tu-dominio.
JELLYFIN_PUBLISHED_URL=http://localhost:8096

# ─── qBittorrent ───────────────────────────────────────────────────────────────
# bootstrap.sh lee la contraseña temporal de los logs, hace login y la
# reemplaza por esta automáticamente. No hace falta ir a buscarla a mano.
QBIT_USERNAME=admin
QBIT_PASSWORD=changeme-strong-password

# ─── Jellyfin ──────────────────────────────────────────────────────────────────
# bootstrap.sh usa esto para completar el startup wizard sin abrir el navegador.
JELLYFIN_ADMIN_USER=admin
JELLYFIN_ADMIN_PASSWORD=changeme-strong-password

# ─── Prowlarr / Indexers ───────────────────────────────────────────────────────
# Lista separada por comas de indexers PÚBLICOS a agregar automáticamente en
# Prowlarr (deben existir con ese nombre exacto en el catálogo de Prowlarr:
# Settings → Indexers → Add Indexer para ver los nombres disponibles).
# Ejemplo con trackers públicos conocidos:
#   PROWLARR_INDEXERS=1337x,The Pirate Bay,YTS,Nyaa.si
# Dejalo vacío si preferís agregar los tuyos (privados) a mano una sola vez
# desde la UI de Prowlarr — de ahí en más se sincronizan solos a Sonarr/Radarr.
PROWLARR_INDEXERS=1337x,The Pirate Bay,YTS

# Categorías de qBittorrent que usan Sonarr/Radarr al mandar descargas
# (bootstrap.sh las crea si no existen).
QBIT_CATEGORY_TV=tv-sonarr
QBIT_CATEGORY_MOVIES=radarr
